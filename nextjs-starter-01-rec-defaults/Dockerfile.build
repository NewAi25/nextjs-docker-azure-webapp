# -------------------------------------------------------
# 1. Base image
# -------------------------------------------------------
FROM node:20-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1


# -------------------------------------------------------
# 2. Install dependencies
# -------------------------------------------------------
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci


# -------------------------------------------------------
# 3. Build Next.js in standalone mode
# -------------------------------------------------------
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Ensure standalone output (Next.js 14+ / 15+)
ENV NEXT_OUTPUT=standalone

RUN npm run build


# -------------------------------------------------------
# 4. Prepare production-only files
# -------------------------------------------------------
FROM node:20-alpine AS prod
WORKDIR /app

# Copy Next.js standalone server
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

# Remove all dev deps
RUN rm -rf node_modules
RUN npm install --only=production


# -------------------------------------------------------
# 5. Create ZIP for Azure App Service
# -------------------------------------------------------
FROM alpine:latest AS zipper
WORKDIR /app

# Copy production build
COPY --from=prod /app .

# Install zip & create deploy.zip
RUN apk add --no-cache zip && \
    mkdir -p /output && \
    zip -r /output/deploy.zip .

# Final output of this container is /output/deploy.zip
